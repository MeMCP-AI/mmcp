# Copy to `.env` and fill in the blanks before running `docker compose up`.

POSTGRES_USER=mmcp
POSTGRES_PASSWORD=mmcp
POSTGRES_DB=mmcp

# 64 hex chars. Generate with: openssl rand -hex 32
MMCP_TOKEN_KEY_HEX=

# Public origin of the server. Must match what OAuth providers are
# configured with. Include the scheme and port.
MMCP_ORIGIN=http://localhost:8787

# Optional GitHub OAuth provider. Leave both unset to disable.
# MMCP_OAUTH_GITHUB_CLIENT_ID=
# MMCP_OAUTH_GITHUB_CLIENT_SECRET=
