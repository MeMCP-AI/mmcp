# Copy this file to .env beside compose.yaml and fill in the required values.
# Never commit .env, it holds secrets.

# Image to run, its tag and when to pull it.
# The default image is ghcr.io/memcp-ai/mmcp-server.
# nightly follows the dev branch, sha-<commit> pins one build, latest will follow releases once a version tag exists.
# missing pulls only when the image is absent, always pulls on every start.
# Run docker compose pull, then docker compose up -d, to update a floating tag.
MMCP_IMAGE=ghcr.io/memcp-ai/mmcp-server
MMCP_IMAGE_TAG=nightly
MMCP_PULL_POLICY=missing

# Host address and port the server is published on.
# 127.0.0.1 keeps it reachable from this host only, 0.0.0.0 exposes it on every interface.
MMCP_PUBLISH_ADDRESS=127.0.0.1
MMCP_PORT=8787

# Exact URL users open in their browser, scheme and port included.
# OAuth callback URLs and passkeys are built from it.
# An https:// origin marks the session cookie Secure, so the site must then be served over HTTPS.
MMCP_ORIGIN=http://localhost:8787

# Optional comma-separated list of other origins allowed to call the API from a browser, for a web UI hosted elsewhere or the web UI dev server.
# Leave it empty when the web UI is served by this server, which is the default.
MMCP_CORS_ALLOWED_ORIGINS=

# Required.
# Generate a value with: docker run --rm ghcr.io/memcp-ai/mmcp-server:nightly generate-secret
# PostgreSQL applies it only when the database volume is first created, so changing it later also needs ALTER USER inside the database.
POSTGRES_USER=mmcp
POSTGRES_PASSWORD=
POSTGRES_DB=mmcp

# Required.
# 64 hexadecimal characters that sign bearer tokens and pending OAuth sign-ins.
# Generate one with: docker run --rm ghcr.io/memcp-ai/mmcp-server:nightly generate-secret
# Changing it invalidates every bearer token and every pending OAuth sign-in.
# Browser sessions live in the database and do not depend on it.
MMCP_TOKEN_KEY_HEX=

# false keeps account creation closed.
# true lets anyone who reaches the server create an account.
# Enable it only to create the first account, then set it back to false and run docker compose up -d again.
MMCP_ALLOW_SELF_REGISTRATION=false

# Shared secret that authorizes git pushes to every group.
# Leave it empty to disable pushes.
MMCP_PUSH_TOKEN=

# Optional GitHub sign-in.
# Leave both values empty to disable it.
# Register MMCP_ORIGIN followed by /auth/oauth/github/callback as the callback URL at GitHub.
MMCP_OAUTH_GITHUB_CLIENT_ID=
MMCP_OAUTH_GITHUB_CLIENT_SECRET=

# Optional account limits, in bytes.
# Leave them empty to keep the server defaults.
MMCP_MIN_PASSWORD_LENGTH=
MMCP_MAX_PASSWORD_LENGTH=
MMCP_MAX_HANDLE_LENGTH=

# Used only with compose.proxy.yaml.
# Name of the existing Docker network the reverse proxy is attached to.
MMCP_PROXY_NETWORK=

# Sign-in and registration requests one client may send per minute, and at once.
# Leave them empty to keep the server defaults.
MMCP_AUTH_RATE_LIMIT_PER_MINUTE=
MMCP_AUTH_RATE_LIMIT_BURST=

# IPv6 clients are told apart by the first bits of their address.
# Addresses that start with the same bits count as one client.
# The default is 64, the usual size of one home or office network.
MMCP_AUTH_RATE_LIMIT_IPV6_CLIENT_PREFIX_LENGTH=

# A second limit counts together every IPv6 client whose address starts with the same, fewer, bits.
# It stops one site from getting around the limit with many addresses.
# The default is 48. Set 0 to switch the second limit off.
MMCP_AUTH_RATE_LIMIT_IPV6_NETWORK_PREFIX_LENGTH=
# Requests per minute, and requests at once, the second limit allows.
# Leave them empty to allow 10 times the values above.
MMCP_AUTH_RATE_LIMIT_IPV6_NETWORK_PER_MINUTE=
MMCP_AUTH_RATE_LIMIT_IPV6_NETWORK_BURST=

# Addresses or CIDR ranges of the reverse proxies in front of mmcp-server, comma-separated.
# Required with compose.proxy.yaml, so each client is limited by its own address and not by the proxy.
MMCP_TRUSTED_PROXIES=
