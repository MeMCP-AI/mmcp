# Keep the build context small. Docker's .dockerignore matches `target/`
# only at the context root, so nested Cargo target dirs (e.g. under
# gui/src-tauri/) need the **/ prefix explicitly.

# Rust build artefacts (root workspace, webui, and any nested project)
**/target/

# Node toolchains.
# The server image runs bun in its webui stage and installs from the checked-in package.json.
# The root-level mask therefore matches every `node_modules/` anywhere in the tree.
**/node_modules/

# SvelteKit build output.
# The server image rebuilds the web UI inside its webui stage.
# Shipping stale `build/` or `.svelte-kit/` dirs wastes context and risks overwriting a hashed bundle.
webui/build/
webui/.svelte-kit/

# Tauri desktop GUI, not part of the server Docker image.
gui/

# VCS and editor state
.git/
.github/
.vscode/
.idea/
.serena/

# Docs and out-of-tree helpers
docs/
mcp/

# Secrets and local-only files
*.log
.env
.env.*
!.env.example
